generator client {
  provider = "prisma-client"
  output   = "../apps/dashboard/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  plan      OrganizationPlan @default(FREE)
  projects  Project[]
  owner     User?
  members   OrganizationMember[]
  incidentMemories IncidentMemory[]
  failurePatterns  FailurePattern[]
  serviceOwnerships ServiceOwnership[]
  serviceOwnershipAssertions ServiceOwnershipAssertion[]
  serviceOwnershipHistory    ServiceOwnershipHistory[]
  changeObservations         ChangeObservation[]
  remediationRecommendations RemediationRecommendation[]
  remediationVerifications   RemediationVerification[]
}

model Project {
  id                String             @id @default(cuid())
  name              String
  slug              String
  organizationId    String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  description       String?
  replayConfig        Json?
  githubRepoOwner     String?
  githubRepoName      String?
  githubToken         String?
  githubDefaultBranch String?            @default("main")
  githubInstallationId String?
  aiProvider          AiProvider         @default(HALO_MANAGED)
  aiEncryptedKey      String?
  aiKeyPrefix         String?
  aiKeySuffix         String?
  aiModel             String?
  aiStatus            AiConnectionStatus @default(NOT_CONFIGURED)
  aiLastTestedAt      DateTime?
  apiKeys             ApiKey[]
  environments        Environment[]
  events              Event[]
  issues              Issue[]
  organization        Organization       @relation(fields: [organizationId], references: [id])
  releases            Release[]
  replaySessions      ReplaySession[]
  telemetrySessions   TelemetrySession[]
  monitors            Monitor[]
  investigations      Investigation[]
  feedbacks           Feedback[]
  repairCases         RepairCase[]
  incidentMemories    IncidentMemory[]
  serviceOwnerships   ServiceOwnership[]
  serviceOwnershipAssertions ServiceOwnershipAssertion[]
  serviceOwnershipHistory    ServiceOwnershipHistory[]
  changeObservations         ChangeObservation[]
  remediationRecommendations RemediationRecommendation[]
  remediationVerifications   RemediationVerification[]

  @@unique([organizationId, slug])
}

model Environment {
  id                String             @id @default(cuid())
  name              String
  projectId         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  apiKeys           ApiKey[]
  project           Project            @relation(fields: [projectId], references: [id])
  events            Event[]
  telemetrySessions TelemetrySession[]

  @@unique([projectId, name])
}

model ApiKey {
  id            String      @id @default(cuid())
  name          String
  keyHash       String
  projectId     String
  environmentId String
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  prefix        String
  environment   Environment @relation(fields: [environmentId], references: [id])
  project       Project     @relation(fields: [projectId], references: [id])
}

model Event {
  id            String            @id @default(cuid())
  type          EventType
  title         String
  message       String?
  timestamp     DateTime
  projectId     String
  environmentId String
  createdAt     DateTime          @default(now())
  metadata      Json?
  release       String?
  sdkName       String?
  sdkVersion    String?
  severity      EventSeverity     @default(INFO)
  issueId       String?
  breadcrumbs   Json?
  fingerprint   String?
  stack         String?
  tags          Json?
  user          Json?
  durationMs    Int?
  operation     String?
  resource      String?
  service       String?
  sessionId     String?
  status        String?
  releaseId     String?
  requestId     String?
  traceId       String?
  environment   Environment       @relation(fields: [environmentId], references: [id])
  issue         Issue?            @relation(fields: [issueId], references: [id])
  project       Project           @relation(fields: [projectId], references: [id])
  releaseRef    Release?          @relation(fields: [releaseId], references: [id])
  session       TelemetrySession? @relation(fields: [sessionId], references: [id])

  @@index([projectId, timestamp])
  @@index([projectId, type, timestamp])
  @@index([projectId, release])
  @@index([projectId, releaseId])
  @@index([projectId, requestId])
  @@index([projectId, traceId])
  @@index([sessionId])
}

model TelemetrySession {
  id            String      @id
  projectId     String
  environmentId String
  userKey       String?
  release       String?
  startedAt     DateTime
  lastSeenAt    DateTime
  crashedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        Event[]
  environment   Environment @relation(fields: [environmentId], references: [id])
  project       Project     @relation(fields: [projectId], references: [id])

  @@index([projectId, startedAt])
  @@index([projectId, lastSeenAt])
  @@index([projectId, release])
  @@index([projectId, userKey])
  @@index([projectId, crashedAt])
}

model Release {
  id         String   @id @default(cuid())
  version    String
  projectId  String
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  eventCount Int      @default(0)
  errorCount Int      @default(0)
  traceCount Int      @default(0)
  commitSha  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  events     Event[]
  project    Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, version])
  @@index([projectId, lastSeen])
  @@index([projectId, version])
}

model Issue {
  id             String          @id @default(cuid())
  fingerprint    String
  title          String
  status         IssueStatus     @default(OPEN)
  firstSeen      DateTime        @default(now())
  lastSeen       DateTime        @default(now())
  projectId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  eventCount     Int             @default(1)
  severity       EventSeverity   @default(INFO)
  lastEventId    String?
  events         Event[]
  project        Project         @relation(fields: [projectId], references: [id])
  replaySessions ReplaySession[]
  investigations Investigation[]
  repairCases    RepairCase[]
  recommendations IssueRecommendation[]

  @@unique([projectId, fingerprint])
}

model User {
  id             String        @id
  name           String
  email          String        @unique
  emailVerified  Boolean       @default(false)
  image          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?       @unique
  accounts       Account[]
  sessions       Session[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  monitors       Monitor[]
  memberships    OrganizationMember[]
  investigationComments InvestigationComment[]
  investigationVerdicts InvestigationVerdict[]
  investigationActivities InvestigationActivity[]
  investigationRelations InvestigationProposedRelation[]
  serviceOwnershipAssertions ServiceOwnershipAssertion[]
  remediationNotes           RemediationNote[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ReplaySession {
  id              String        @id @default(cuid())
  sessionId       String        @unique
  projectId       String
  environmentId   String
  issueId         String?
  traceId         String?
  requestId       String?
  browser         String?
  os              String?
  device          String?
  url             String?
  userAgent       String?
  viewportWidth   Int?
  viewportHeight  Int?
  startedAt       DateTime
  endedAt         DateTime?
  errorAt         DateTime?
  triggerType     String?
  captureReason   String?
  triggerTimestamp DateTime?
  status          ReplayStatus  @default(RECORDING)
  totalDurationMs Int?
  chunkCount      Int           @default(0)
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chunks          ReplayChunk[]
  issue           Issue?        @relation(fields: [issueId], references: [id])
  project         Project       @relation(fields: [projectId], references: [id])
  feedbacks       Feedback[]

  @@index([projectId, startedAt])
  @@index([projectId, status])
  @@index([issueId])
  @@index([sessionId])
  @@index([expiresAt])
}

model Feedback {
  id              String         @id @default(cuid())
  projectId       String
  sessionId       String?
  replaySessionId String?
  name            String?
  email           String?
  comments        String
  url             String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id])
  replaySession   ReplaySession? @relation(fields: [replaySessionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sessionId])
  @@index([replaySessionId])
}

model ReplayChunk {
  id              String        @id @default(cuid())
  replaySessionId String
  sequence        Int
  events          Json
  startedAt       DateTime
  endedAt         DateTime
  eventCount      Int
  sizeBytes       Int
  createdAt       DateTime      @default(now())
  replaySession   ReplaySession @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)

  @@unique([replaySessionId, sequence])
  @@index([replaySessionId, sequence])
}

enum EventType {
  ERROR
  LOG
  MESSAGE
  TRACE
}

enum EventSeverity {
  INFO
  WARNING
  ERROR
  FATAL
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum OrganizationPlan {
  FREE
  DEVELOPER
  TEAM
}

enum ReplayStatus {
  RECORDING
  PROCESSING
  AVAILABLE
  EXPIRED
  DISABLED
  ERROR
}

enum MonitorType {
  ERROR
  METRIC
  CRON
  UPTIME
  MOBILE_BUILD
}

enum MonitorStatus {
  HEALTHY
  FIRING
  MUTED
  DISABLED
}

enum MonitorSeverity {
  INFO
  WARNING
  ERROR
  FATAL
}

model Monitor {
  id              String          @id @default(cuid())
  name            String
  description     String?
  type            MonitorType     @default(ERROR)
  status          MonitorStatus   @default(HEALTHY)
  severity        MonitorSeverity @default(ERROR)
  projectId       String
  environmentId   String?
  creatorId       String?
  thresholdValue  Float?
  thresholdWindow Int?            // minutes window
  query           String?         // filter expression or issue target
  cronSchedule    String?         // cron expression
  endpointUrl     String?         // target URL for uptime
  lastTriggeredAt DateTime?
  lastEvaluatedAt DateTime?
  incidentCount   Int             @default(0)
  alertConfig     Json?           // webhooks / notify channels
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator         User?           @relation(fields: [creatorId], references: [id])
  alerts          MonitorAlert[]
  investigations  Investigation[]

  @@index([projectId, type])
  @@index([projectId, status])
  @@index([status])
}

enum MonitorAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model MonitorAlert {
  id              String               @id @default(cuid())
  monitorId       String
  status          MonitorAlertStatus   @default(OPEN)
  triggeredAt     DateTime             @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  // The condition that was met when the alert fired
  conditionSummary String             // human-readable e.g. "Error count 14 >= threshold 5 in 10m"
  observedValue   Float?              // raw observed value at trigger time
  thresholdValue  Float?              // configured threshold at trigger time
  notes           String?             // optional operator notes
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  monitor         Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifications   MonitorAlertNotification[]
  investigation   Investigation?

  @@index([monitorId])
  @@index([status])
  @@index([triggeredAt])
}

enum NotificationChannel {
  EMAIL
  WEBHOOK
  IN_APP
}

enum NotificationOutcome {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

model MonitorAlertNotification {
  id          String              @id @default(cuid())
  alertId     String
  channel     NotificationChannel @default(EMAIL)
  destination String?             // email address, webhook URL, etc.
  outcome     NotificationOutcome @default(PENDING)
  failReason  String?
  attemptedAt DateTime            @default(now())

  alert       MonitorAlert        @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
}

enum InvestigationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Investigation {
  id              String              @id @default(cuid())
  projectId       String
  issueId         String?
  monitorId       String?
  alertId         String?             @unique
  status          InvestigationStatus @default(COMPLETED)
  title           String
  summary         String?
  rootCause       String?
  confidenceScore Float?
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  evidenceCount   Int                 @default(0)
  context         Json?               // stores monitor / trigger context snapshot
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue           Issue?              @relation(fields: [issueId], references: [id], onDelete: SetNull)
  monitor         Monitor?            @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  alert           MonitorAlert?       @relation(fields: [alertId], references: [id], onDelete: SetNull)
  repairCases     RepairCase[]
  recommendations IssueRecommendation[]
  comments        InvestigationComment[]
  verdicts        InvestigationVerdict[]
  activities      InvestigationActivity[]
  proposedRelations InvestigationProposedRelation[]
  incidentMemory  IncidentMemory?
  remediationRecommendations RemediationRecommendation[]
  remediationVerifications   RemediationVerification[]

  @@index([projectId, createdAt])
  @@index([monitorId])
  @@index([issueId])
}

enum AiProvider {
  HALO_MANAGED
  GEMINI
  OPENAI
}

enum AiConnectionStatus {
  NOT_CONFIGURED
  CONNECTED
  FAILED
}

enum RepairCaseStatus {
  AVAILABLE
  ANALYZING
  READY
  CHANGES_PROPOSED
  VALIDATION_RUNNING
  VALIDATED
  FAILED
  BLOCKED
}

enum RepairOutcome {
  REPAIRABLE
  PARTIALLY_REPAIRABLE
  BLOCKED
  AMBIGUOUS
  NO_CODE_CHANGE_REQUIRED
  ALREADY_FIXED
  VALIDATION_FAILED
}

enum RepairConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum ValidationRunStatus {
  NOT_RUN
  RUNNING
  PASSED
  FAILED
  BLOCKED
  NOT_APPLICABLE
}

model RepairCase {
  id                    String                @id @default(cuid())
  projectId             String
  issueId               String
  investigationId       String?
  status                RepairCaseStatus      @default(AVAILABLE)
  outcome               RepairOutcome?
  evidenceSnapshotId    String
  repositorySnapshotId  String?
  version               Int                   @default(1)
  title                 String
  whatBroke             String
  whyItBroke            String
  failureMechanism      String
  upstreamReasonStatus  String                @default("UNRESOLVED")
  upstreamReason        String?
  brokenBoundary        Json?
  confidenceLevel       RepairConfidenceLevel @default(MEDIUM)
  confidenceReason      String
  remainingUncertainty  String?
  context               Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue                 Issue                 @relation(fields: [issueId], references: [id], onDelete: Cascade)
  investigation         Investigation?        @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  changes               RepairChange[]
  validations           RepairValidation[]
  events                RepairEvent[]

  @@index([projectId, createdAt])
  @@index([issueId])
  @@index([investigationId])
}

model RepairChange {
  id             String                @id @default(cuid())
  repairCaseId   String
  filePath       String
  symbol         String?
  sourceRange    Json?
  reason         String
  whyThisFile    String?
  beforeSnippet  String
  afterSnippet   String
  unifiedDiff    String
  confidence     RepairConfidenceLevel @default(HIGH)
  evidenceIds    String[]
  order          Int                   @default(0)
  applied        Boolean               @default(false)
  appliedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  repairCase     RepairCase            @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)

  @@index([repairCaseId])
  @@index([filePath])
}

model RepairValidation {
  id                  String              @id @default(cuid())
  repairCaseId        String
  status              ValidationRunStatus @default(NOT_RUN)
  typecheckPassed     Boolean?
  typecheckOutput     String?
  testsPassed         Boolean?
  testOutput          String?
  buildPassed         Boolean?
  buildOutput         String?
  reproductionPassed  Boolean?
  reproductionOutput  String?
  telemetryVerified   Boolean?
  telemetryOutput     String?
  patchAppliesCleanly Boolean?
  errors              Json?
  durationMs          Int?
  executedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  repairCase          RepairCase          @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)

  @@index([repairCaseId])
  @@index([status])
}

model RepairEvent {
  id           String     @id @default(cuid())
  repairCaseId String
  eventType    String
  message      String
  payload      Json?
  createdAt    DateTime   @default(now())

  repairCase   RepairCase @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)

  @@index([repairCaseId, createdAt])
}

model IssueRecommendation {
  id              String         @id @default(cuid())
  issueId         String
  investigationId String?
  version         Int            @default(1)
  snapshotHash    String
  isStale         Boolean        @default(false)
  recommendation  Json
  followUpHistory Json?
  modelProvider   String
  modelName       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  issue           Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  investigation   Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)

  @@index([issueId, version])
  @@index([investigationId])
}

// ---------------------------------------------------------------------------
// Team Plan Foundation: Multi-Member Organization & Roles
// ---------------------------------------------------------------------------

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// PHASE 4 / PILLAR C: COLLABORATIVE LIVE INVESTIGATION ROOMS
// -----------------------------------------------------------------------------

enum InvestigationCommentTargetType {
  INVESTIGATION
  HYPOTHESIS
  EVIDENCE
  CAUSAL_EDGE
  TOPOLOGY_NODE
  REPLAY
}

model InvestigationComment {
  id              String                         @id @default(cuid())
  investigationId String
  authorId        String
  authorName      String
  authorEmail     String
  targetType      InvestigationCommentTargetType @default(INVESTIGATION)
  targetId        String?                        // e.g. hypothesisId, edgeId, serviceName, replaySessionId
  evidenceId      String?                        // linked event/evidence ID
  metadata        Json?                          // replay timestamp, edge source/target, etc.
  content         String
  isDeleted       Boolean                        @default(false)
  idempotencyKey  String?                        @unique
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  investigation   Investigation                  @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  user            User                           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([investigationId, createdAt])
  @@index([authorId])
}

enum PeerVerdictType {
  SUPPORTED
  DISPUTED
  NEEDS_EVIDENCE
  UNRESOLVED
}

model InvestigationVerdict {
  id                 String          @id @default(cuid())
  investigationId    String
  hypothesisId       String          // hypothesis identifier
  authorId           String
  authorName         String
  authorEmail        String
  verdict            PeerVerdictType
  reasoning          String?
  evidenceReferences String[]        @default([]) // array of eventId / evidence IDs
  idempotencyKey     String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  investigation      Investigation   @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([investigationId, hypothesisId, authorId])
  @@index([investigationId, hypothesisId])
}

enum InvestigationActivityType {
  MEMBER_JOINED
  MEMBER_LEFT
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  VERDICT_RECORDED
  EVIDENCE_ANNOTATED
  RELATIONSHIP_PROPOSED
}

model InvestigationActivity {
  id              String                    @id @default(cuid())
  investigationId String
  actorId         String
  actorName       String
  actorEmail      String
  type            InvestigationActivityType
  summary         String                    // e.g. "Asha supported Hypothesis 2", "Rahul annotated payments-service"
  targetType      String?                   // e.g. "HYPOTHESIS", "EVIDENCE", "TOPOLOGY_NODE", "REPLAY"
  targetId        String?
  metadata        Json?
  createdAt       DateTime                  @default(now())

  investigation   Investigation             @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  user            User                      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([investigationId, createdAt])
}

model InvestigationProposedRelation {
  id              String        @id @default(cuid())
  investigationId String
  authorId        String
  authorName      String
  sourceId        String        // eventId or service name
  targetId        String        // eventId or service name
  relationType    String        // e.g. "CAUSES", "CORRELATED_WITH", "DEPENDS_ON"
  classification  String        @default("HUMAN_PROPOSED") // Always HUMAN_PROPOSED, NEVER OBSERVED or INFERRED
  reasoning       String?
  evidenceIds     String[]      @default([])
  createdAt       DateTime      @default(now())

  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([investigationId, createdAt])
}

// ---------------------------------------------------------------------------
// Team Plan Pillar D: Organizational Failure Memory & Incident Intelligence
// ---------------------------------------------------------------------------

model IncidentMemory {
  id                  String              @id @default(cuid())
  investigationId     String              @unique
  projectId           String
  organizationId      String
  fingerprint         String              // structural similarity fingerprint (service:operation:errorType)
  title               String
  normalizedTitle     String
  primaryService      String
  primaryOperation    String?
  errorType           String?
  rootCause           String?             // from canonical investigation (null if honest uncertainty)
  confidenceScore     Float?
  status              InvestigationStatus @default(COMPLETED)
  affectedServices    String[]            @default([])
  causalChainSummary  Json?               // snapshot of verified hops, roles, origin
  topologyEdges       Json?               // snapshot of active dependency edges
  evidenceReferences  String[]            @default([]) // event IDs linked to incident
  humanVerdicts       Json?               // snapshot of peer verdicts with attribution
  recommendations     Json?               // snapshot of recommendations
  memoryVersion       Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  investigation       Investigation       @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([organizationId, fingerprint])
  @@index([primaryService])
}

model FailurePattern {
  id                  String        @id @default(cuid())
  organizationId      String
  projectId           String?       // null if cross-project pattern within org
  patternKey          String        // deterministic pattern identifier (e.g. service:errorType)
  title               String
  primaryService      String
  affectedServices    String[]      @default([])
  incidentCount       Int           @default(1)
  firstSeenAt         DateTime
  lastSeenAt          DateTime
  commonCausalSummary Json?
  investigationIds    String[]      @default([])
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, patternKey])
  @@index([organizationId, lastSeenAt])
  @@index([primaryService])
}

// ---------------------------------------------------------------------------
// Team Plan Pillar E: Ownership Intelligence & Engineering Responsibility
// ---------------------------------------------------------------------------

enum OwnershipClassification {
  DECLARED
  INFERRED
  HISTORICAL
  UNKNOWN
  HUMAN_ASSERTION
}

enum OwnershipSourceType {
  CODEOWNERS
  SERVICE_CONFIG
  REPOSITORY_METADATA
  HISTORICAL_INCIDENT
  SOURCE_CORRELATION
  MANUAL_ASSERTION
}

model ServiceOwnership {
  id              String                  @id @default(cuid())
  organizationId  String
  projectId       String?
  serviceName     String
  declaredOwner   String
  declaredTeam    String?
  ownerType       String                  @default("TEAM")
  classification  OwnershipClassification @default(DECLARED)
  source          OwnershipSourceType     @default(SERVICE_CONFIG)
  sourcePath      String?
  repositoryUrl   String?
  commitSha       String?
  confidenceLevel String                  @default("HIGH")
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId, serviceName, source])
  @@index([organizationId, serviceName])
  @@index([projectId, serviceName])
}

model ServiceOwnershipAssertion {
  id              String                  @id @default(cuid())
  organizationId  String
  projectId       String?
  serviceName     String
  authorId        String
  authorName      String
  authorEmail     String
  statement       String
  proposedOwner   String
  scope           String?
  classification  OwnershipClassification @default(HUMAN_ASSERTION)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, serviceName])
  @@index([projectId, serviceName])
  @@index([authorId])
}

model ServiceOwnershipHistory {
  id              String                  @id @default(cuid())
  organizationId  String
  projectId       String?
  serviceName     String
  previousOwner   String?
  newOwner        String
  source          OwnershipSourceType     @default(SERVICE_CONFIG)
  sourceVersion   String?
  reason          String?
  changedAt       DateTime                @default(now())

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, serviceName, changedAt])
  @@index([projectId, serviceName])
}

// ---------------------------------------------------------------------------
// Team Plan Pillar F: Change Intelligence & Causal Change Analysis
// ---------------------------------------------------------------------------

enum ChangeSourceType {
  GIT_COMMIT
  DEPLOYMENT_EVENT
  PULL_REQUEST
  CONFIGURATION_CHANGE
  DEPENDENCY_CHANGE
  FEATURE_FLAG_CHANGE
}

enum ChangeRelationshipType {
  UNRELATED
  TEMPORALLY_RELATED
  SERVICE_RELATED
  CODE_PATH_RELATED
  BEHAVIORALLY_RELATED
  STRONGLY_SUPPORTED
  INSUFFICIENT_EVIDENCE
}

model ChangeObservation {
  id                   String                 @id @default(cuid())
  organizationId       String
  projectId            String
  changeKey            String                 // Deterministic deduplication key for idempotency
  repository           String?
  commitSha            String?
  parentCommitSha      String?
  commitMessage        String?
  authorIdentity       String?                // Historical metadata only; author != owner != culprit
  authorTimestamp      DateTime?
  sourceType           ChangeSourceType       @default(GIT_COMMIT)
  sourceVersion        String?
  deploymentReference  String?
  pullRequestReference String?
  changedFiles         Json?                  // array of changed file paths or objects
  additions            Int?
  deletions            Int?
  branch               String?
  ref                  String?
  serviceAssociation   String?
  codePathAssociation  String?
  evidenceReferences   String[]               @default([])
  observedAt           DateTime               @default(now())
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, changeKey])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, commitSha])
  @@index([organizationId, repository, commitSha])
  @@index([authorTimestamp])
}

// ---------------------------------------------------------------------------
// Team Plan Pillar H: Evidence-Backed Remediation Intelligence
// ---------------------------------------------------------------------------

enum RemediationType {
  CODE_CHANGE
  CONFIGURATION_REVIEW
  DEPENDENCY_REVIEW
  DEPLOYMENT_REVIEW
  FEATURE_FLAG_REVIEW
  DATA_VALIDATION
  OBSERVABILITY_GAP
  REGRESSION_TEST
  ROLLBACK_REVIEW
  DOCUMENTATION_UPDATE
  RUNBOOK_REVIEW
}

enum RemediationStatus {
  ACTIONABLE
  NEEDS_VALIDATION
  INSUFFICIENT_EVIDENCE
  BLOCKED
  COMPLETED
  DISMISSED
}

enum RemediationSupportLevel {
  EVIDENCE_BACKED
  PARTIALLY_SUPPORTED
  INSUFFICIENT_EVIDENCE
}

enum RemediationRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model RemediationRecommendation {
  id                   String                  @id @default(cuid())
  organizationId       String
  projectId            String
  investigationId      String
  recommendationKey    String                  // Deterministic deduplication key for idempotency
  type                 RemediationType
  status               RemediationStatus       @default(ACTIONABLE)
  supportLevel         RemediationSupportLevel @default(EVIDENCE_BACKED)
  riskLevel            RemediationRiskLevel    @default(LOW)
  title                String
  summary              String?
  action               String
  rationale            String?
  expectedOutcome      String?
  validationMethod     String?
  prerequisites        String[]                @default([])
  evidenceReferences   String[]                @default([])
  supportingClaimIds   String[]                @default([])
  affectedServices     String[]                @default([])
  affectedOperations   String[]                @default([])
  affectedCodePaths    String[]                @default([])
  ownerContext         Json?                   // Routing context only: declared owner, source, confidence (no blame)
  uncertainty          String?
  completedAt          DateTime?
  completedBy          String?                 // Human user id who marked completed
  dismissedAt          DateTime?
  dismissedBy          String?                 // Human user id who dismissed
  dismissalReason      String?
  historicalContext    Json?                   // Historical remediation comparison if similar incident exists
  contradictionNotes   String?                 // If multiple alternative remediation paths exist
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investigation        Investigation           @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  notes                RemediationNote[]
  verifications        RemediationVerification[]

  @@unique([investigationId, recommendationKey])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([investigationId, status])
}

model RemediationNote {
  id               String                    @id @default(cuid())
  recommendationId String
  userId           String
  userEmail        String?
  userName         String?
  content          String
  createdAt        DateTime                  @default(now())

  recommendation   RemediationRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recommendationId, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Team Plan Pillar I: Remediation Verification & Resolution Intelligence
// ---------------------------------------------------------------------------

enum VerificationResult {
  RESOLVED
  IMPROVED
  NOT_RESOLVED
  REGRESSED
  UNKNOWN
  INSUFFICIENT_DATA
}

enum VerificationStrength {
  HIGH
  MEDIUM
  LOW
}

model RemediationVerification {
  id                         String                    @id @default(cuid())
  organizationId             String
  projectId                  String
  investigationId            String
  recommendationId           String

  result                     VerificationResult
  strength                   VerificationStrength      @default(MEDIUM)

  baselineStart              DateTime
  baselineEnd                DateTime
  postStart                  DateTime
  postEnd                    DateTime

  baselineSampleCount        Int                       @default(0)
  postSampleCount            Int                       @default(0)

  baselineFailureCount       Int                       @default(0)
  postFailureCount           Int                       @default(0)

  baselineFailureRate        Float                     @default(0.0)
  postFailureRate            Float                     @default(0.0)

  baselineP50                Float?
  postP50                    Float?

  baselineP95                Float?
  postP95                    Float?

  baselineP99                Float?
  postP99                    Float?

  targetService              String?
  targetOperation            String?
  originalFailureFingerprint String?
  regressionFingerprint      String?

  evidenceReferences         String[]                  @default([])
  regressionSignals          Json?                     // Array of detected regression anomalies
  failureComparison          Json?                     // Structured Before / After comparison
  uncertainty                String?
  explanation                String?
  temporalAnchor             Json?                     // Anchor type, timestamp, source id

  verifiedAt                 DateTime                  @default(now())
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                    Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investigation              Investigation             @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  recommendation             RemediationRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([investigationId, createdAt])
  @@index([recommendationId, createdAt])
}

