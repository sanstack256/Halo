generator client {
  provider = "prisma-client"
  output   = "../apps/dashboard/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  plan      OrganizationPlan @default(FREE)
  projects  Project[]
  owner     User?
}

model Project {
  id                String             @id @default(cuid())
  name              String
  slug              String
  organizationId    String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  description       String?
  replayConfig        Json?
  githubRepoOwner     String?
  githubRepoName      String?
  githubToken         String?
  githubDefaultBranch String?            @default("main")
  githubInstallationId String?
  apiKeys             ApiKey[]
  environments        Environment[]
  events              Event[]
  issues              Issue[]
  organization        Organization       @relation(fields: [organizationId], references: [id])
  releases            Release[]
  replaySessions      ReplaySession[]
  telemetrySessions   TelemetrySession[]
  monitors            Monitor[]
  investigations      Investigation[]

  @@unique([organizationId, slug])
}

model Environment {
  id                String             @id @default(cuid())
  name              String
  projectId         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  apiKeys           ApiKey[]
  project           Project            @relation(fields: [projectId], references: [id])
  events            Event[]
  telemetrySessions TelemetrySession[]

  @@unique([projectId, name])
}

model ApiKey {
  id            String      @id @default(cuid())
  name          String
  keyHash       String
  projectId     String
  environmentId String
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  prefix        String
  environment   Environment @relation(fields: [environmentId], references: [id])
  project       Project     @relation(fields: [projectId], references: [id])
}

model Event {
  id            String            @id @default(cuid())
  type          EventType
  title         String
  message       String?
  timestamp     DateTime
  projectId     String
  environmentId String
  createdAt     DateTime          @default(now())
  metadata      Json?
  release       String?
  sdkName       String?
  sdkVersion    String?
  severity      EventSeverity     @default(INFO)
  issueId       String?
  breadcrumbs   Json?
  fingerprint   String?
  stack         String?
  tags          Json?
  user          Json?
  durationMs    Int?
  operation     String?
  resource      String?
  service       String?
  sessionId     String?
  status        String?
  releaseId     String?
  requestId     String?
  traceId       String?
  environment   Environment       @relation(fields: [environmentId], references: [id])
  issue         Issue?            @relation(fields: [issueId], references: [id])
  project       Project           @relation(fields: [projectId], references: [id])
  releaseRef    Release?          @relation(fields: [releaseId], references: [id])
  session       TelemetrySession? @relation(fields: [sessionId], references: [id])

  @@index([projectId, timestamp])
  @@index([projectId, type, timestamp])
  @@index([projectId, release])
  @@index([projectId, releaseId])
  @@index([projectId, requestId])
  @@index([projectId, traceId])
  @@index([sessionId])
}

model TelemetrySession {
  id            String      @id
  projectId     String
  environmentId String
  userKey       String?
  release       String?
  startedAt     DateTime
  lastSeenAt    DateTime
  crashedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        Event[]
  environment   Environment @relation(fields: [environmentId], references: [id])
  project       Project     @relation(fields: [projectId], references: [id])

  @@index([projectId, startedAt])
  @@index([projectId, lastSeenAt])
  @@index([projectId, release])
  @@index([projectId, userKey])
  @@index([projectId, crashedAt])
}

model Release {
  id         String   @id @default(cuid())
  version    String
  projectId  String
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  eventCount Int      @default(0)
  errorCount Int      @default(0)
  traceCount Int      @default(0)
  commitSha  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  events     Event[]
  project    Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, version])
  @@index([projectId, lastSeen])
  @@index([projectId, version])
}

model Issue {
  id             String          @id @default(cuid())
  fingerprint    String
  title          String
  status         IssueStatus     @default(OPEN)
  firstSeen      DateTime        @default(now())
  lastSeen       DateTime        @default(now())
  projectId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  eventCount     Int             @default(1)
  severity       EventSeverity   @default(INFO)
  lastEventId    String?
  events         Event[]
  project        Project         @relation(fields: [projectId], references: [id])
  replaySessions ReplaySession[]
  investigations Investigation[]

  @@unique([projectId, fingerprint])
}

model User {
  id             String        @id
  name           String
  email          String        @unique
  emailVerified  Boolean       @default(false)
  image          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?       @unique
  accounts       Account[]
  sessions       Session[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  monitors       Monitor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ReplaySession {
  id              String        @id @default(cuid())
  sessionId       String        @unique
  projectId       String
  environmentId   String
  issueId         String?
  traceId         String?
  requestId       String?
  browser         String?
  os              String?
  device          String?
  url             String?
  userAgent       String?
  viewportWidth   Int?
  viewportHeight  Int?
  startedAt       DateTime
  endedAt         DateTime?
  errorAt         DateTime?
  status          ReplayStatus  @default(RECORDING)
  totalDurationMs Int?
  chunkCount      Int           @default(0)
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chunks          ReplayChunk[]
  issue           Issue?        @relation(fields: [issueId], references: [id])
  project         Project       @relation(fields: [projectId], references: [id])

  @@index([projectId, startedAt])
  @@index([projectId, status])
  @@index([issueId])
  @@index([sessionId])
  @@index([expiresAt])
}

model ReplayChunk {
  id              String        @id @default(cuid())
  replaySessionId String
  sequence        Int
  events          Json
  startedAt       DateTime
  endedAt         DateTime
  eventCount      Int
  sizeBytes       Int
  createdAt       DateTime      @default(now())
  replaySession   ReplaySession @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)

  @@unique([replaySessionId, sequence])
  @@index([replaySessionId, sequence])
}

enum EventType {
  ERROR
  LOG
  MESSAGE
  TRACE
}

enum EventSeverity {
  INFO
  WARNING
  ERROR
  FATAL
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum OrganizationPlan {
  FREE
  DEVELOPER
  TEAM
}

enum ReplayStatus {
  RECORDING
  PROCESSING
  AVAILABLE
  EXPIRED
  DISABLED
  ERROR
}

enum MonitorType {
  ERROR
  METRIC
  CRON
  UPTIME
  MOBILE_BUILD
}

enum MonitorStatus {
  HEALTHY
  FIRING
  MUTED
  DISABLED
}

enum MonitorSeverity {
  INFO
  WARNING
  ERROR
  FATAL
}

model Monitor {
  id              String          @id @default(cuid())
  name            String
  description     String?
  type            MonitorType     @default(ERROR)
  status          MonitorStatus   @default(HEALTHY)
  severity        MonitorSeverity @default(ERROR)
  projectId       String
  environmentId   String?
  creatorId       String?
  thresholdValue  Float?
  thresholdWindow Int?            // minutes window
  query           String?         // filter expression or issue target
  cronSchedule    String?         // cron expression
  endpointUrl     String?         // target URL for uptime
  lastTriggeredAt DateTime?
  lastEvaluatedAt DateTime?
  incidentCount   Int             @default(0)
  alertConfig     Json?           // webhooks / notify channels
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator         User?           @relation(fields: [creatorId], references: [id])
  alerts          MonitorAlert[]
  investigations  Investigation[]

  @@index([projectId, type])
  @@index([projectId, status])
  @@index([status])
}

enum MonitorAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model MonitorAlert {
  id              String               @id @default(cuid())
  monitorId       String
  status          MonitorAlertStatus   @default(OPEN)
  triggeredAt     DateTime             @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  // The condition that was met when the alert fired
  conditionSummary String             // human-readable e.g. "Error count 14 >= threshold 5 in 10m"
  observedValue   Float?              // raw observed value at trigger time
  thresholdValue  Float?              // configured threshold at trigger time
  notes           String?             // optional operator notes
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  monitor         Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifications   MonitorAlertNotification[]
  investigation   Investigation?

  @@index([monitorId])
  @@index([status])
  @@index([triggeredAt])
}

enum NotificationChannel {
  EMAIL
  WEBHOOK
  IN_APP
}

enum NotificationOutcome {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

model MonitorAlertNotification {
  id          String              @id @default(cuid())
  alertId     String
  channel     NotificationChannel @default(EMAIL)
  destination String?             // email address, webhook URL, etc.
  outcome     NotificationOutcome @default(PENDING)
  failReason  String?
  attemptedAt DateTime            @default(now())

  alert       MonitorAlert        @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
}

enum InvestigationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Investigation {
  id              String              @id @default(cuid())
  projectId       String
  issueId         String?
  monitorId       String?
  alertId         String?             @unique
  status          InvestigationStatus @default(COMPLETED)
  title           String
  summary         String?
  rootCause       String?
  confidenceScore Float?
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  evidenceCount   Int                 @default(0)
  context         Json?               // stores monitor / trigger context snapshot
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue           Issue?              @relation(fields: [issueId], references: [id], onDelete: SetNull)
  monitor         Monitor?            @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  alert           MonitorAlert?       @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([monitorId])
  @@index([issueId])
}

