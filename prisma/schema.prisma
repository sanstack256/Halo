generator client {
  provider = "prisma-client"
  output   = "../apps/dashboard/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  plan      OrganizationPlan @default(FREE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  projects  Project[]
  owner     User?
}

model Project {
  id                String             @id @default(cuid())
  name              String
  slug              String
  organizationId    String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  description       String?
  replayConfig      Json?
  apiKeys           ApiKey[]
  environments      Environment[]
  events            Event[]
  issues            Issue[]
  organization      Organization       @relation(fields: [organizationId], references: [id])
  telemetrySessions TelemetrySession[]
  releases          Release[]
  replaySessions    ReplaySession[]

  @@unique([organizationId, slug])
}

model Environment {
  id                String             @id @default(cuid())
  name              String
  projectId         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  apiKeys           ApiKey[]
  project           Project            @relation(fields: [projectId], references: [id])
  events            Event[]
  telemetrySessions TelemetrySession[]

  @@unique([projectId, name])
}

model ApiKey {
  id            String      @id @default(cuid())
  name          String
  keyHash       String
  projectId     String
  environmentId String
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  prefix        String
  environment   Environment @relation(fields: [environmentId], references: [id])
  project       Project     @relation(fields: [projectId], references: [id])
}

model Event {
  id            String            @id @default(cuid())
  type          EventType
  title         String
  message       String?
  timestamp     DateTime
  projectId     String
  environmentId String
  createdAt     DateTime          @default(now())

  metadata      Json?

  release       String?
  releaseId     String?
  releaseRef    Release?          @relation(fields: [releaseId], references: [id])

  sdkName       String?
  sdkVersion    String?

  severity      EventSeverity     @default(INFO)

  issueId       String?

  breadcrumbs   Json?
  fingerprint   String?
  stack         String?
  tags          Json?
  user          Json?

  durationMs    Int?
  operation     String?
  resource      String?
  service       String?
  sessionId     String?
  status        String?

  requestId     String?
  traceId       String?

  environment   Environment       @relation(fields: [environmentId], references: [id])
  issue         Issue?            @relation(fields: [issueId], references: [id])
  project       Project           @relation(fields: [projectId], references: [id])
  session       TelemetrySession? @relation(fields: [sessionId], references: [id])

  @@index([projectId, timestamp])
  @@index([projectId, type, timestamp])
  @@index([projectId, release])
  @@index([projectId, releaseId])
  @@index([projectId, requestId])
  @@index([projectId, traceId])
  @@index([sessionId])
}

model TelemetrySession {
  id            String      @id
  projectId     String
  environmentId String
  userKey       String?
  release       String?
  startedAt     DateTime
  lastSeenAt    DateTime
  crashedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        Event[]
  environment   Environment @relation(fields: [environmentId], references: [id])
  project       Project     @relation(fields: [projectId], references: [id])

  @@index([projectId, startedAt])
  @@index([projectId, lastSeenAt])
  @@index([projectId, release])
  @@index([projectId, userKey])
  @@index([projectId, crashedAt])
}

model Release {
  id          String   @id @default(cuid())

  version     String

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])

  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  eventCount  Int      @default(0)
  errorCount  Int      @default(0)
  traceCount  Int      @default(0)

  events      Event[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId, lastSeen])
  @@index([projectId, version])
}

model Issue {
  id          String        @id @default(cuid())
  fingerprint String
  title       String
  status      IssueStatus   @default(OPEN)
  firstSeen   DateTime      @default(now())
  lastSeen    DateTime      @default(now())
  projectId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  eventCount  Int           @default(1)
  severity    EventSeverity @default(INFO)
  lastEventId String?
  events      Event[]
  project     Project       @relation(fields: [projectId], references: [id])
  replaySessions ReplaySession[]

  @@unique([projectId, fingerprint])
}

model User {
  id             String        @id
  name           String
  email          String        @unique
  emailVerified  Boolean       @default(false)
  image          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?       @unique
  accounts       Account[]
  sessions       Session[]
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum EventType {
  ERROR
  LOG
  MESSAGE
  TRACE
}

enum EventSeverity {
  INFO
  WARNING
  ERROR
  FATAL
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum OrganizationPlan {
  FREE
  DEVELOPER
  TEAM
}

model ReplaySession {
  id              String              @id @default(cuid())
  sessionId       String              @unique
  projectId       String
  environmentId   String
  issueId         String?
  traceId         String?
  requestId       String?
  browser         String?
  os              String?
  device          String?
  url             String?
  userAgent       String?
  viewportWidth   Int?
  viewportHeight  Int?
  startedAt       DateTime
  endedAt         DateTime?
  errorAt         DateTime?
  status          ReplayStatus        @default(RECORDING)
  totalDurationMs Int?
  chunkCount      Int                 @default(0)
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project         Project             @relation(fields: [projectId], references: [id])
  issue           Issue?              @relation(fields: [issueId], references: [id])
  chunks          ReplayChunk[]

  @@index([projectId, startedAt])
  @@index([projectId, status])
  @@index([issueId])
  @@index([sessionId])
  @@index([expiresAt])
}

model ReplayChunk {
  id              String        @id @default(cuid())
  replaySessionId String
  sequence        Int
  events          Json
  startedAt       DateTime
  endedAt         DateTime
  eventCount      Int
  sizeBytes       Int
  createdAt       DateTime      @default(now())

  replaySession   ReplaySession @relation(fields: [replaySessionId], references: [id], onDelete: Cascade)

  @@unique([replaySessionId, sequence])
  @@index([replaySessionId, sequence])
}

enum ReplayStatus {
  RECORDING
  PROCESSING
  AVAILABLE
  EXPIRED
  DISABLED
  ERROR
}
