# ==============================================================================
# Halo Platform — Environment Configuration
# ==============================================================================

# Database
# Production PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/halo?sslmode=require"

# Authentication (Better Auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-byte-base64-random-secret"
# Full public URL of your deployed dashboard (e.g., https://app.halo.run)
BETTER_AUTH_URL="https://app.your-domain.com"
NEXT_PUBLIC_APP_URL="https://app.your-domain.com"

# CORS & Ingestion
# Comma-separated list of web origins permitted to send browser telemetry & session replays
# e.g., "https://myfrontend.com,https://staging.myfrontend.com" or "*"
ALLOWED_ORIGINS="https://myfrontend.com,https://app.myfrontend.com"

# Email (Resend)
RESEND_API_KEY="re_..."

# OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub App Integration (Optional — for Source Context & blame resolution)
GITHUB_APP_ID=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_PRIVATE_KEY=""
