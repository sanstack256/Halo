{
  "name": "@halo-trace/sdk",
  "version": "1.0.0",
  "description": "Official SDK for Halo Trace observability and production investigation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "halo",
    "halo-trace",
    "observability",
    "monitoring",
    "error-monitoring",
    "debugging",
    "developer-tools",
    "tracing"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@halo-trace/sdk": "1.0.0"
  }
}