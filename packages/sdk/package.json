{
  "name": "@halo-trace/sdk",
  "version": "1.0.0",
  "description": "Official unified SDK platform for Halo Trace observability, runtime telemetry, and session replay.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.js",
      "require": "./dist/nextjs.cjs"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./dist/replay.js",
      "require": "./dist/replay.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "keywords": [
    "halo",
    "halo-trace",
    "observability",
    "monitoring",
    "error-monitoring",
    "debugging",
    "developer-tools",
    "tracing",
    "session-replay"
  ],
  "license": "MIT",
  "dependencies": {
    "@halo-trace/replay": "workspace:*",
    "@halo-trace/sdk-browser": "workspace:*",
    "@halo-trace/sdk-core": "workspace:*",
    "@halo-trace/sdk-nextjs": "workspace:*",
    "@halo-trace/sdk-node": "workspace:*",
    "@halo-trace/sdk-react": "workspace:*",
    "@halo-trace/sdk-types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}