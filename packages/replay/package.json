{
  "name": "@halo-trace/replay",
  "version": "0.1.0",
  "description": "Halo Session Replay — browser DOM recording and reconstruction for error investigation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "halo",
    "session-replay",
    "rrweb",
    "debugging"
  ],
  "license": "MIT",
  "dependencies": {
    "rrweb": "^2.0.0-alpha.18"
  },
  "devDependencies": {
    "@rrweb/types": "^2.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@halo-trace/sdk": "workspace:*"
  }
}
