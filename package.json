    "db:studio:neon": "DATABASE_URL=\"$NEON_DATABASE_URL\" prisma studio"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "7.9.1",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}